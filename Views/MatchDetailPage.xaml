<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MatchMemoApp.ViewModels"
             xmlns:model="clr-namespace:MatchMemoApp.Models"
             x:Class="MatchMemoApp.Views.MatchDetailPage"
             x:DataType="viewmodel:MatchDetailViewModel"
             Title="{Binding Title}">

    <Grid>
        <!-- メインコンテンツ -->
        <ScrollView x:Name="MainScrollView">
            <StackLayout>
                <!-- 試合情報ヘッダー -->
                <Frame BackgroundColor="#007ACC" HasShadow="True" CornerRadius="0" Padding="15">
                    <StackLayout>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" 
                                   Text="{Binding CurrentMatch.HomeTeamName}" 
                                   TextColor="White" FontSize="16" FontAttributes="Bold" 
                                   HorizontalOptions="Center" />

                            <Label Grid.Column="1" 
                                   Text="vs" 
                                   TextColor="White" FontSize="18" FontAttributes="Bold" 
                                   HorizontalOptions="Center" />

                            <Label Grid.Column="2" 
                                   Text="{Binding CurrentMatch.AwayTeamName}" 
                                   TextColor="White" FontSize="16" FontAttributes="Bold" 
                                   HorizontalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding CurrentMatch.Date, StringFormat='{0:yyyy/MM/dd}'}" 
                               TextColor="White" FontSize="14" 
                               HorizontalOptions="Center" />

                        <Label Text="{Binding CurrentMatch.Stadium}" 
                               TextColor="White" FontSize="12" 
                               HorizontalOptions="Center" 
                               IsVisible="{Binding CurrentMatch.Stadium, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    </StackLayout>
                </Frame>

                <!-- タイマー表示 -->
                <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15">
                    <StackLayout>
                        <Label Text="{Binding MatchTimeDisplay}" 
                               FontSize="36" FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               TextColor="#007ACC" />

                        <!-- タイマー操作ボタン -->
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10" 
                                     IsVisible="{Binding IsRealTimeMode}">
                            <Button Text="{Binding IsTimerRunning, Converter={StaticResource BoolToPlayPauseTextConverter}}" 
                                    Command="{Binding StartStopTimerCommand}" 
                                    BackgroundColor="{Binding IsTimerRunning, Converter={StaticResource BoolToColorConverter}}"
                                    TextColor="White"
                                    WidthRequest="60" />
                            <Button Text="⏹️" Command="{Binding ResetTimerCommand}" 
                                    BackgroundColor="Gray" TextColor="White" WidthRequest="50" />
                            <Button Text="+1" Command="{Binding AddMinuteCommand}" 
                                    BackgroundColor="#4CAF50" TextColor="White" WidthRequest="50" />
                            <Button Text="-1" Command="{Binding SubtractMinuteCommand}" 
                                    BackgroundColor="#F44336" TextColor="White" WidthRequest="50" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- フィールド表示 -->
                <Frame BackgroundColor="White" HasShadow="True" CornerRadius="10" Padding="15" Margin="10">
                    <StackLayout>
                        <Label Text="フィールド" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

                        <!-- フィールド -->
                        <Frame BackgroundColor="#4CAF50" HeightRequest="650" WidthRequest="400" 
                               HorizontalOptions="Center" HasShadow="False" CornerRadius="5"
                               BorderColor="White">

                            <!-- Grid で InputTransparent を使用してタップイベントを管理 -->
                            <Grid x:Name="FieldGrid">
                                <!-- フィールドライン背景（タップを透過） -->
                                <AbsoluteLayout x:Name="FieldLinesLayout" InputTransparent="True">
                                    <!-- 外枠（フィールドライン） -->
                                    <Rectangle Fill="Transparent" 
                                              Stroke="White" 
                                              StrokeThickness="4"
                                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                                              AbsoluteLayout.LayoutFlags="All" />

                                    <!-- ハーフライン -->
                                    <BoxView Color="White" 
                                           AbsoluteLayout.LayoutBounds="0,0.5,1,0.006"
                                           AbsoluteLayout.LayoutFlags="All" />

                                    <!-- センターサークル -->
                                    <Ellipse Fill="Transparent" 
                                            Stroke="White" 
                                            StrokeThickness="3"
                                            AbsoluteLayout.LayoutBounds="0.5,0.5,100,100"
                                            AbsoluteLayout.LayoutFlags="PositionProportional" />

                                    <!-- ホームチームペナルティエリア (下) -->
                                    <Rectangle Fill="Transparent" 
                                              Stroke="White" 
                                              StrokeThickness="3"
                                              AbsoluteLayout.LayoutBounds="0.3,0.85,140,90"
                                              AbsoluteLayout.LayoutFlags="PositionProportional" />

                                    <!-- アウェイチームペナルティエリア (上) -->
                                    <Rectangle Fill="Transparent" 
                                              Stroke="White" 
                                              StrokeThickness="3"
                                              AbsoluteLayout.LayoutBounds="0.3,0.15,140,90"
                                              AbsoluteLayout.LayoutFlags="PositionProportional" />

                                    <!-- ホームチームゴールエリア (下) -->
                                    <Rectangle Fill="Transparent" 
                                              Stroke="White" 
                                              StrokeThickness="2"
                                              AbsoluteLayout.LayoutBounds="0.375,0.92,80,50"
                                              AbsoluteLayout.LayoutFlags="PositionProportional" />

                                    <!-- アウェイチームゴールエリア (上) -->
                                    <Rectangle Fill="Transparent" 
                                              Stroke="White" 
                                              StrokeThickness="2"
                                              AbsoluteLayout.LayoutBounds="0.375,0.08,80,50"
                                              AbsoluteLayout.LayoutFlags="PositionProportional" />

                                    <!-- チームラベル -->
                                    <Label Text="{Binding CurrentMatch.AwayTeamName}" 
                                           TextColor="White" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           BackgroundColor="#80000000"
                                           Padding="8,4"
                                           AbsoluteLayout.LayoutBounds="0.5,0.08,-1,-1"
                                           AbsoluteLayout.LayoutFlags="PositionProportional" 
                                           HorizontalOptions="Center" />

                                    <Label Text="{Binding CurrentMatch.HomeTeamName}" 
                                           TextColor="White" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           BackgroundColor="#80000000"
                                           Padding="8,4"
                                           AbsoluteLayout.LayoutBounds="0.5,0.92,-1,-1"
                                           AbsoluteLayout.LayoutFlags="PositionProportional" 
                                           HorizontalOptions="Center" />
                                </AbsoluteLayout>

                                <!-- 選手レイアウト（タップイベントを受ける） -->
                                <AbsoluteLayout x:Name="FieldLayout" />
                            </Grid>
                        </Frame>

                        <!-- チーム凡例 -->
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Margin="0,10,0,0">
                            <StackLayout Orientation="Horizontal">
                                <Frame BackgroundColor="#2196F3" WidthRequest="20" HeightRequest="20" CornerRadius="10" />
                                <Label Text="{Binding CurrentMatch.HomeTeamName}" VerticalOptions="Center" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Frame BackgroundColor="#F44336" WidthRequest="20" HeightRequest="20" CornerRadius="10" />
                                <Label Text="{Binding CurrentMatch.AwayTeamName}" VerticalOptions="Center" />
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- 選択中の選手情報表示 -->
                <Frame BackgroundColor="White" HasShadow="True" CornerRadius="10" Padding="15" Margin="10"
                       IsVisible="{Binding SelectedPlayer, Converter={StaticResource IsNotNullConverter}}">
                    <StackLayout Orientation="Horizontal">
                        <Frame BackgroundColor="{Binding IsHomeTeamSelected, Converter={StaticResource BoolToTeamColorConverter}}" 
                               WidthRequest="40" HeightRequest="40" 
                               CornerRadius="20" HasShadow="False" 
                               Padding="0" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPlayer.Number}" 
                                   TextColor="White" FontSize="18" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <StackLayout HorizontalOptions="StartAndExpand">
                            <Label Text="{Binding SelectedPlayer.Name}" 
                                   FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding SelectedPlayer.Position}" 
                                   FontSize="14" TextColor="Gray" />
                        </StackLayout>
                        <Button Text="メモを記録" 
                                Command="{Binding ShowMemoEditorCommand}"
                                BackgroundColor="#4CAF50" 
                                TextColor="White" 
                                CornerRadius="8" 
                                VerticalOptions="Center" />
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ScrollView>

        <!-- メモエディターモーダルオーバーレイ -->
        <ContentView x:Name="MemoEditorModal" 
                     BackgroundColor="#CC000000" 
                     IsVisible="{Binding IsEditorVisible}"
                     ZIndex="9999">

            <!-- 背景タップでキャンセル -->
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelMemoEditCommand}" />
            </ContentView.GestureRecognizers>

            <!-- エディター本体 -->
            <Frame BackgroundColor="White" 
                   CornerRadius="20" 
                   HasShadow="True" 
                   Padding="20"
                   Margin="20"
                   VerticalOptions="Center">

                <!-- エディター内容タップで伝播を防ぐ -->
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer />
                </Frame.GestureRecognizers>

                <ScrollView MaximumHeightRequest="500">
                    <StackLayout Spacing="15">
                        <!-- ヘッダー：選手情報 -->
                        <StackLayout Orientation="Horizontal" 
                                     IsVisible="{Binding SelectedPlayer, Converter={StaticResource IsNotNullConverter}}">
                            <Frame BackgroundColor="{Binding IsHomeTeamSelected, Converter={StaticResource BoolToTeamColorConverter}}" 
                                   WidthRequest="35" HeightRequest="35" 
                                   CornerRadius="17.5" HasShadow="False" 
                                   Padding="0" VerticalOptions="Center">
                                <Label Text="{Binding SelectedPlayer.Number}" 
                                       TextColor="White" FontSize="16" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <StackLayout VerticalOptions="Center" HorizontalOptions="StartAndExpand">
                                <Label Text="{Binding SelectedPlayer.Name}" 
                                       FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedPlayer.Position}" 
                                       FontSize="14" TextColor="Gray" />
                            </StackLayout>
                            <Button Text="×" 
                                    Command="{Binding CancelMemoEditCommand}"
                                    BackgroundColor="Transparent" 
                                    TextColor="Gray" 
                                    FontSize="24"
                                    WidthRequest="40" HeightRequest="40"
                                    CornerRadius="20" />
                        </StackLayout>

                        <!-- 過去のメモ一覧（コンパクト表示） -->
                        <StackLayout>
                            <Label Text="過去のメモ" FontSize="16" FontAttributes="Bold" />
                            <Frame BackgroundColor="#F8F8F8" CornerRadius="10" Padding="10" MaximumHeightRequest="150">
                                <CollectionView ItemsSource="{Binding CurrentPlayerMemos}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="model:Memo">
                                            <Grid Padding="5">
                                                <StackLayout>
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Text="{Binding MatchMinute, StringFormat='{0}分'}" 
                                                               FontSize="12" FontAttributes="Bold" 
                                                               TextColor="#666" />
                                                        <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}" 
                                                               FontSize="12" TextColor="#999" 
                                                               HorizontalOptions="EndAndExpand" />
                                                    </StackLayout>
                                                    <Label Text="{Binding Content}" 
                                                           FontSize="13" />
                                                </StackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.EmptyView>
                                        <Label Text="まだメモがありません" 
                                               FontSize="14" TextColor="Gray" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center" 
                                               Padding="20" />
                                    </CollectionView.EmptyView>
                                </CollectionView>
                            </Frame>
                        </StackLayout>

                        <!-- メモ入力エリア -->
                        <StackLayout>
                            <Label Text="新しいメモ" FontSize="16" FontAttributes="Bold" />
                            <Editor x:Name="MemoEditor"
                                    Text="{Binding MemoText}" 
                                    HeightRequest="80"
                                    Placeholder="メモを入力してください..." 
                                    Focused="OnMemoEditorFocused"
                                    Unfocused="OnMemoEditorUnfocused" />
                        </StackLayout>

                        <!-- クイックメモ（フォーカス時のみ表示） -->
                        <StackLayout x:Name="QuickMemoSection" IsVisible="{Binding IsEditorFocused}">
                            <Label Text="クイックメモ" FontSize="14" FontAttributes="Bold" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding MemoTemplates}" 
                                       Wrap="Wrap" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Text="{Binding .}" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MatchDetailViewModel}}, Path=AddTemplateCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E3F2FD" 
                                                TextColor="#1976D2"
                                                FontSize="12" 
                                                Margin="2" 
                                                CornerRadius="15" 
                                                Padding="8,4" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </StackLayout>

                        <!-- 操作ボタン -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Text="キャンセル" 
                                    Command="{Binding CancelMemoEditCommand}"
                                    BackgroundColor="#757575" 
                                    TextColor="White" 
                                    CornerRadius="10" 
                                    Margin="0,0,5,0" />

                            <Button Grid.Column="1" 
                                    Text="保存" 
                                    Command="{Binding SaveMemoCommand}"
                                    BackgroundColor="#4CAF50" 
                                    TextColor="White" 
                                    CornerRadius="10" 
                                    Margin="5,0,0,0" />
                        </Grid>
                    </StackLayout>
                </ScrollView>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>